#!/bin/sh
# Auto-push to origin after every successful local commit
# This hook will push the current branch to the 'origin' remote.

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
remote=$(git remote get-url origin 2>/dev/null)

if [ -z "$remote" ]; then
  echo "[post-commit] No 'origin' remote configured; skipping auto-push."
  exit 0
fi

echo "[post-commit] Pushing branch '$branch' to origin..."
git push origin "$branch" || echo "[post-commit] Auto-push failed — please push manually."
